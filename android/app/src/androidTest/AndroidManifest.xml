<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- See NoopAccessibilityService: enabled by the emulator workflow so
             Compose reports screen changes on every Android version. -->
        <service
            android:name="app.clairix.NoopAccessibilityService"
            android:exported="true"
            android:label="Clairix test accessibility service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/noop_accessibility_service" />
        </service>
    </application>
</manifest>
