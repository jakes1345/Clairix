<?xml version="1.0" encoding="utf-8"?>
<!--
    Full edition with the whole app (the fullSuite variant) only. The card vault's
    Host Card Emulation service lives here rather than in src/suite so that the
    Play edition, which ships without card emulation, never declares it, and the
    comms-only build, which has no NFC tab, never did.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Host Card Emulation service — replays recorded ISO 14443-4 APDU conversations so
            the phone can act as a stored access card. Only activates when the user explicitly
            enables emulation for a vault card; no data is sent until a reader initiates contact.
        -->
        <service
            android:name=".CardEmulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/hce_service"/>
        </service>

    </application>
</manifest>
