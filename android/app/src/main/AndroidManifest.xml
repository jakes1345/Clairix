<?xml version="1.0" encoding="utf-8"?>
<!--
    What every flavour declares: COMMS and the app shell. This on its own is the
    comms-only APK. The scanner and the tools — their permissions, hardware
    features, package queries and components — are added by
    src/suite/AndroidManifest.xml, which the manifest merger folds in for the
    suite tier only. The card vault's emulation service is added by
    src/fullSuite/AndroidManifest.xml, for the full edition's suite only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SOS: the position attached to a panic message. In the full app the scanner
         holds a live fix; without one, a fresh fix is taken at the moment SOS is
         pressed and at no other time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- COMMS: the camera scans a contact's pairing QR code; the relay connection
         runs in a foreground service of the special-use type while the owner
         keeps comms online (its reason is given on CommsService below). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- COMMS calls: the microphone for the call itself, audio routing for
         speaker/earpiece, a microphone-type foreground service while a call is
         up, and a full-screen ring for incoming calls when the screen is off. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Lets the owner exempt Clairix from battery optimisation, which on many
         phones (Samsung especially) otherwise cuts the background relay connection
         so incoming calls never ring, and stops the scanner while the phone sleeps.
         Asked for from COMMS settings, and on the Scan hub while the scanner is on. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- COMMS calls: the proximity sensor switches the screen off at the ear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bring the relay connection back after a reboot or an update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Fake incoming call (Comms menu, both editions): rings at the exact moment
         the owner picked, even in Doze. A special access the owner grants. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The relay (and, in the full app, map tile downloads from OpenStreetMap). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClairixApp"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clairix">

        <!--
            Portrait only, because every screen is laid out and tested for it alone.
            The vault no longer needs it: BiometricPrompt's result goes through
            Registry.vaultAuth, and whichever MainActivity instance is on screen
            when it lands carries the operation out. The lock (here, on the two
            call screens, the wipe relaunch and the QR scanner) comes off once the
            layouts, and a vault unlock rotated mid-prompt, have been run on a
            tablet and an unfolded foldable; from targetSdk 36 Android ignores it
            on screens 600 dp wide and up anyway.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Clairix">
            <!--
                The launcher entry is not here but on the aliases below, so discreet
                mode can show a neutral one instead (security/DiscreetMode.kt).
            -->
            <!--
                COMMS invites: https://clairix.app/i#<invite>. The domain names this
                app and its signing key (/.well-known/assetlinks.json), so Android
                opens these links in Clairix alone; no other app can claim them.
                The page there opens Clairix with an intent naming this package.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="clairix.app" android:path="/i" />
            </intent-filter>
            <!--
                Invite links made before Beta 8 open the inviter's relay's page,
                which opens clairix://invite?c=… with an intent naming this package.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clairix" android:host="invite" />
            </intent-filter>
        </activity>

        <!--
            Launcher entries for MainActivity, exactly one enabled at a time
            (security/DiscreetMode.kt). LauncherClairix is the app as it is. The
            other two are discreet mode's neutral entries, off until the owner
            picks one in Settings; Google Play's policy does not allow disguising
            the launcher icon, so the Play edition's manifest removes them
            (src/play/AndroidManifest.xml). Declared after MainActivity, as an
            alias must be. Android's own lists (Settings, Apps) still show the
            package's label, Clairix.
        -->
        <activity-alias
            android:name=".LauncherClairix"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCompass"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_compass"
            android:label="@string/launcher_compass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:label="@string/launcher_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            The call screen incoming-call and ongoing-call notifications open. It
            alone shows over the lock screen and turns the display on (declared
            here as well, so the system opens it from a locked phone without asking
            for the PIN first), and runs in its own task so ending the call returns
            to wherever the owner was. Not exported: only Clairix's own notifications
            can open it, so no other app can make Clairix answer a call.
        -->
        <!-- A call ringing on a locked phone, before its offer can be opened. -->
        <activity
            android:name=".LockedRingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="app.clairix.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Clairix" />
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="app.clairix.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Clairix" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An update stops the COMMS connection; bring it back. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            COMMS relay connection. Holds the WebSocket to the owner's relay while
            comms are online, so encrypted envelopes arrive the moment they are
            queued. When it is not running, a UnifiedPush wake-up (below) or opening
            the app fetches the inbox instead. None of Android's named service types
            fits a relay socket (remoteMessaging is for moving messages between a
            person's own devices), so it is a special-use service, and the property
            states why for Google Play's review (docs/play/foreground-services.md).
        -->
        <service
            android:name=".comms.CommsService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the end-to-end-encrypted relay connection open so incoming calls and messages arrive without a Google push service" />
        </service>

        <!--
            UnifiedPush receiver: a distributor app the owner installs (ntfy, for
            example) wakes Clairix here. The push carries nothing; the app then
            fetches its inbox over the signed relay channel. No Google service.
        -->
        <service
            android:name=".comms.CommsPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!--
            An encrypted call in progress: holds the microphone and the WebRTC
            connection while the owner talks. Started only from a Clairix screen
            (placing a call, or answering one on the call screen).
        -->
        <service
            android:name=".comms.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Periodic check that the background relay connection is still alive. -->
        <receiver
            android:name=".comms.LinkWatchdog"
            android:exported="false" />

        <!-- The TLS canary's four-hourly check: an alarm the system keeps, so it runs
             whether or not the process that armed it is still alive. -->
        <receiver
            android:name=".analysis.TlsCanaryAlarm"
            android:exported="false" />

        <!-- Decline / hang-up buttons on call notifications. -->
        <receiver
            android:name=".comms.CallActionReceiver"
            android:exported="false" />

        <!--
            Fake incoming call: a pretend ring the owner schedules as a reason to
            leave, in the Comms menu of both editions. Its screen shows over the
            lock screen like a real call and is kept out of recents; only Clairix's
            own alarm and notification can open it.
        -->
        <activity
            android:name=".security.FakeCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="app.clairix.fakecall"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Clairix" />

        <!-- The fake call's alarm and its Decline button. -->
        <receiver
            android:name=".security.FakeCallReceiver"
            android:exported="false" />

        <!--
            The fake call's ring: a short foreground service (no type permission and
            no prerequisites; the ring lasts 45 s) that plays the phone's ringtone
            and vibrates from the background, under a wake lock, so the call rings
            whether or not any screen opens. Its notification is the incoming-call
            card. Started by the alarm; ends with the ring (answer, decline, Cancel
            or the ring's own timer). On Android 12 and 13, which have no such type,
            it runs as an untyped foreground service.
        -->
        <service
            android:name=".security.FakeCallRingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!--
            After the duress passcode's wipe: ends the process that showed the old
            data and opens the lock screen afresh in a new one. Runs for a moment in
            a process of its own, since a process cannot reliably restart itself.
            Not exported: only the wipe starts it.
        -->
        <activity
            android:name=".security.WipeRelaunchActivity"
            android:exported="false"
            android:process=":relaunch"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Clairix" />

        <!-- A wipe's request to the relay to delete the account, tried again until
             the relay takes it or it expires (a day), whether or not Clairix runs. -->
        <receiver
            android:name=".security.RelayFarewellAlarm"
            android:exported="false" />

        <!-- History older than the owner's retention, deleted once a day even when
             neither the scanner nor the app is open. -->
        <receiver
            android:name=".security.HistoryRetentionAlarm"
            android:exported="false" />

        <!-- Portrait QR scanner for pairing; the library's default is landscape. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
