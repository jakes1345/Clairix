<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground, in the app's accent orange (#FF7A3D) over the
    #0E1116 background layer.
    A rounded shield outline with a lens-shaped eye inside: flat, no text.
    108dp adaptive-icon canvas; everything sits inside the 66dp safe zone
    centred on (54,54), so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF7A3D"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:pathData="M54,29 C60.5,32.5 67,34 74,34.6 L74,52 C74,65.5 65.5,75 54,79.5 C42.5,75 34,65.5 34,52 L34,34.6 C41,34 47.5,32.5 54,29 Z" />

    <!-- Eye / lens outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF7A3D"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M42,54 Q54,43 66,54 Q54,65 42,54 Z" />

    <!-- Iris, with the pupil cut out so the background shows through -->
    <path
        android:fillColor="#FF7A3D"
        android:fillType="evenOdd"
        android:pathData="M54,48.5 A5.5,5.5 0 1,1 54,59.5 A5.5,5.5 0 1,1 54,48.5 Z M54,51.8 A2.2,2.2 0 1,1 54,56.2 A2.2,2.2 0 1,1 54,51.8 Z" />

</vector>
