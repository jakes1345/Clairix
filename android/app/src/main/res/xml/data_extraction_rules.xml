<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone. Cloud backup is off (allowBackup="false"); a
    "copy apps & data" device transfer on Android 12+ is governed by this file,
    not by that flag, so every domain is excluded here as well. The COMMS
    identity and the card vault are sealed to this phone's Keystore and would
    be unusable elsewhere; the scanner's location log, timeline, cell baseline,
    trips and unlock ledger are a record of where the owner has been and must
    not travel with the account to a phone someone else holds.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
