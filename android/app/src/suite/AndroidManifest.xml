<?xml version="1.0" encoding="utf-8"?>
<!--
    The suite flavour's additions to src/main/AndroidManifest.xml, which declares
    only what COMMS needs. Everything here belongs to the scanner and the tools,
    so the comms-only APK never asks for any of it. The card-emulation service is
    not here: only the full edition declares it (src/fullSuite/AndroidManifest.xml),
    so the Play build carries no HostApduService at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Advertising: the detector self-test (a fake AirTag payload for a few
         seconds) and the offline mesh while the owner has it on. Nothing is
         advertised otherwise. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Stalkerware scan: Android 11+ hides most installed apps from a package
         listing without this, and an app hiding on the phone is the whole point.
         The scan reads every installed package on the phone and sends nothing
         about them anywhere (analysis/StalkwareScanner.kt; the Play declaration
         is docs/play/query-all-packages.md). -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Wi-Fi checks: read the connected network and the scan cache, and ask the
         platform for a fresh scan (throttled by Android): while the scanner runs,
         every two minutes with the screen on or the phone moving and every ten
         minutes once it has settled with the screen off; with the scanner off,
         once a minute from the Wi-Fi tab while it is open; and once per tap of
         "Scan for setup hotspots" under Hidden cameras. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Cell tab: the data network type (LTE / NR / HSPA+). A normal permission on
         Android 13+, granted at install; on 12 the read is skipped. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!-- NFC / HF RFID passive tag sweep -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- Unlock ledger: the platform's own record of the keyguard going away and
         the screen turning on, which fills in unlocks from before Clairix's device
         admin was enabled (and any while it was switched off). A special-access
         permission the owner grants in Settings → Usage access; nothing is read
         without it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Screen-recording detection on Android 15+: a normal permission that lets
         the window manager tell Clairix when its own screen is inside a recording. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- Phone check's Advanced Protection row on Android 16+: a normal permission,
         granted at install, without which the platform refuses to say whether the
         mode is on. Older releases do not know it and ignore it. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!-- Window shield (security/WindowShield.kt): while a Clairix screen shows, Android hides
         every other app's overlay windows, so nothing is drawn over a warning or a button. A
         normal permission, granted at install; Android 12 and newer. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Drive mode: RTL-SDR dongle over USB host, OBD-II over Bluetooth. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
        Device tab: the root managers and hooking frameworks PhoneHealthMonitor
        reports when installed. While QUERY_ALL_PACKAGES above is held every
        package is visible anyway, so this list changes nothing today; it is kept
        so these checks still see their packages if that permission is ever
        withdrawn (a store review, or a build without it). The stalkerware check
        does need every package: it matches every installed app against its signed
        stalkerware list (analysis/StalkwareIoc.kt) by package name and signing
        certificate, so no stalkerware is named here.
    -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.vvb2060.magisk" />
        <package android:name="io.github.huskydg.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.kingo.root" />
        <package android:name="com.zachspong.temprootremovejb" />
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="org.meowcat.edxposed.manager" />
        <package android:name="org.lsposed.manager" />
        <package android:name="com.saurik.substrate" />
        <package android:name="re.frida.server" />
        <!--
            Makes every active device admin visible so its label can be resolved
            through its receiver component; without this the Device tab showed raw
            package names. Same for accessibility services, whose ResolveInfo the
            platform supplies but whose package would otherwise stay hidden.
        -->
        <intent>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent>
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
    </queries>

    <!-- largeHeap: a state's road graph and its routing arrays run to hundreds of MB. -->
    <application android:largeHeap="true">

        <!-- NFC tags tapped while Clairix is not in reader mode arrive as intents. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".DriveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
            Turn-by-turn navigation: keeps location fixes coming once per second with
            the screen off. Started and stopped by the navigation session only.
        -->
        <service
            android:name=".nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Offline mesh: carries sealed COMMS envelopes phone to phone over Bluetooth
            while the owner has it on (Comms menu, Offline mesh). Off by default.
        -->
        <service
            android:name=".comms.mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Unlock ledger: a device admin with the watch-login policy, so the
            platform reports every lock-screen success, failure and credential
            change, and force-lock, so the Fake call page's "Schedule and lock" can
            lock the screen (res/xml/unlock_admin.xml); nothing else. Exported with
            the system-only BIND_DEVICE_ADMIN permission, as every admin receiver
            must be; the owner activates it from the Device tab.
        -->
        <receiver
            android:name=".security.UnlockAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/unlock_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            Clean link (links/LinkCleanerActivity.kt): shared text (Share → Clean link) or selected
            text (the text-selection menu) with its links cleaned of tracking parameters and
            redirect wrappers, on the phone, with no network request. Exported, as a share target
            must be; it reads only the text it is handed and returns nothing but, for a selection,
            the cleaned text. Discreet mode switches it off (security/DiscreetMode.kt).
        -->
        <activity
            android:name=".links.LinkCleanerActivity"
            android:exported="true"
            android:label="@string/link_clean_link"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Clairix">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The fake call's activity, receiver and ring service are declared in
             src/main/AndroidManifest.xml: the Comms menu carries Fake call in both
             editions. -->

    </application>
</manifest>
