  "font": {
    "family": {
      "sans": {
        "name": "Inter",
        "stack": "\"Inter\", \"Inter Variable\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "license": "SIL OFL 1.1"
      },
      "display": {
        "name": "Inter Display",
        "stack": "\"Inter Display\", \"Inter\", system-ui, sans-serif",
        "note": "Inter's optical size for 20 px and up: tighter spacing, finer details.",
        "license": "SIL OFL 1.1"
      },
      "mono": {
        "name": "JetBrains Mono",
        "stack": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
        "note": "Only for machine values: MAC addresses, cell IDs, certificate fingerprints.",
        "license": "SIL OFL 1.1"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
