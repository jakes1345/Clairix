  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "$description": "4 px grid, px / dp."
  },
  "radius": {
    "$description": "Hard edges. Corners are tight or chamfered, never bubbly. px / dp.",
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 14,
    "full": 9999,
    "chamfer": 8
  },
  "elevation": {
    "0": {
      "dp": 0,
      "surface": "base",
      "shadow": "none"
    },
    "1": {
      "dp": 1,
      "surface": "surface",
      "shadow": "0 1px 0 rgb(255 255 255 / 0.04) inset"
    },
    "2": {
      "dp": 3,
      "surface": "surfaceRaised",
      "shadow": "0 1px 0 rgb(255 255 255 / 0.05) inset, 0 6px 16px rgb(0 0 0 / 0.45)"
    },
    "3": {
      "dp": 6,
      "surface": "surfaceOverlay",
      "shadow": "0 1px 0 rgb(255 255 255 / 0.06) inset, 0 16px 40px rgb(0 0 0 / 0.6)"
    },
    "$description": "On black, depth comes from surface steps and a hairline border; shadows only separate floating layers."
  },
  "motion": {
    "$description": "Fast and decisive. Snaps in, settles quickly, never bounces. Reduced motion drops to instant.",
    "duration": {
      "instant": 0,
      "fast": 90,
      "base": 160,
      "slow": 260,
      "reveal": 420
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "snap": [
        0.5,
        0,
        0.1,
        1
      ],
      "exit": [
        0.4,
        0,
        1,
        1
      ],
      "emphasized": [
        0.05,
        0.7,
        0.1,
        1
      ]
    }
  }
}
