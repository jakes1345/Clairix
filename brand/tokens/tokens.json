  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80,
    "24": 96,
    "$description": "4 px base grid. Values in px / dp."
  },
  "radius": {
    "$description": "px / dp. Corners stay soft but not bubbly.",
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },
  "elevation": {
    "0": {
      "dp": 0,
      "shadow": "none"
    },
    "1": {
      "dp": 1,
      "shadow": "0 1px 2px oklch(0.17 0.02 264 / 0.06), 0 1px 1px oklch(0.17 0.02 264 / 0.04)"
    },
    "2": {
      "dp": 3,
      "shadow": "0 2px 6px oklch(0.17 0.02 264 / 0.07), 0 1px 2px oklch(0.17 0.02 264 / 0.05)"
    },
    "3": {
      "dp": 6,
      "shadow": "0 8px 24px oklch(0.17 0.02 264 / 0.08), 0 2px 6px oklch(0.17 0.02 264 / 0.05)"
    },
    "4": {
      "dp": 12,
      "shadow": "0 24px 48px oklch(0.17 0.02 264 / 0.12), 0 6px 12px oklch(0.17 0.02 264 / 0.06)"
    },
    "$description": "Shadows are soft and low-contrast: depth is mostly carried by surface colour. 'dp' is the Compose tonal/shadow elevation."
  },
  "motion": {
    "$description": "Calm motion: short, decelerating, no bounce. Respect reduced-motion by dropping to 'instant'.",
    "duration": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "slow": 320,
      "reveal": 480
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "decelerate": [
        0,
        0,
        0,
        1
      ],
      "accelerate": [
        0.3,
        0,
        1,
        1
      ],
      "emphasized": [
        0.16,
        1,
        0.3,
        1
      ]
    }
  }
}
