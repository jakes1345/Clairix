  "font": {
    "family": {
      "display": {
        "name": "Archivo Expanded",
        "css": "Archivo",
        "stretch": "125%",
        "stack": "\"Archivo\", \"Arial Black\", sans-serif",
        "note": "Archivo at width 125. Headlines, numbers that matter, merch. Uppercase, ExtraBold or Black.",
        "license": "SIL OFL 1.1"
      },
      "ui": {
        "name": "Archivo",
        "css": "Archivo",
        "stretch": "100%",
        "stack": "\"Archivo\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "note": "Archivo at normal width. Everything people read: body, labels, buttons. Same skeleton as the display cut, so the two always match.",
        "license": "SIL OFL 1.1"
      },
      "mono": {
        "name": "JetBrains Mono",
        "css": "JetBrains Mono",
        "stretch": "100%",
        "stack": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
        "note": "Machine values only: MAC addresses, cell IDs, fingerprints.",
        "license": "SIL OFL 1.1"
      }
    },
    "scale": {
      "$description": "size and lineHeight in px (= sp). tracking in em. family: display | ui | mono. case: upper where the style is always set in capitals. web: marketing only.",
      "displayXl": {
        "size": 72,
        "lineHeight": 72,
        "weight": 900,
        "tracking": -0.01,
        "family": "display",
        "case": "upper",
        "web": true
      },
