{
  "name": "clairix-relay",
  "version": "2.0.0",
  "private": true,
  "description": "Cloudflare Worker relay for Clairix comms: store-and-forward of end-to-end encrypted envelopes between Clairix apps, addressed by Clairix number.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/harness/register.mjs --test test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "relay-key": "node scripts/relay-key.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@noble/curves": "2.4.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.0"
  }
}
