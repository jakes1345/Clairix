#!/bin/sh
# Asks the relay for its status page; after three misses in a row (six
# minutes), restarts it. systemd already restarts it when the process dies;
# this catches it hanging.
set -u
STATE=/run/clairix-relay-check.misses
if curl -fsS -m 10 -o /dev/null http://127.0.0.1:8787/; then
  rm -f "$STATE"
  exit 0
fi
misses=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$misses" > "$STATE"
echo "relay did not answer ($misses in a row)"
if [ "$misses" -ge 3 ]; then
  rm -f "$STATE"
  echo "restarting clairix-relay"
  systemctl restart clairix-relay.service
fi
