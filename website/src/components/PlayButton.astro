---
import Icon from './Icon.astro';
import { GET_APP_URL, PLAY_LIVE } from '../config/site';

interface Props {
  size?: 'md' | 'lg';
  label?: string;
}
const { size = 'md', label = 'Get it on Google Play' } = Astro.props;
---

{
  PLAY_LIVE ? (
    <a class:list={['btn', 'cham', 'cham--oct', { 'btn--lg': size === 'lg' }]} href={GET_APP_URL} rel="noopener">
      <Icon name="play" size={16} />
      {label}
      <Icon name="arrowRight" size={18} class="icon--move" />
    </a>
  ) : (
    <a class:list={['btn', 'cham', 'cham--oct', { 'btn--lg': size === 'lg' }]} href={GET_APP_URL}>
      Download the beta
      <Icon name="arrowDown" size={18} />
    </a>
  )
}
