---
import Icon from './Icon.astro';
import { PLAY_URL } from '../config/site';

interface Props {
  size?: 'md' | 'lg';
  label?: string;
}
const { size = 'md', label = 'Get it on Google Play' } = Astro.props;
---

<a class:list={['btn', 'cham', 'cham--oct', { 'btn--lg': size === 'lg' }]} href={PLAY_URL} rel="noopener">
  <Icon name="play" size={16} />
  {label}
  <Icon name="arrowRight" size={18} class="icon--move" />
</a>
