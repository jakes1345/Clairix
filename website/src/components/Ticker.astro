---
/** Scrolling strip of what Clairix checks. Decorative: the same words are headings below. */
const items = ['Hidden cameras', 'Trackers', 'Spyware', 'Fake networks', 'Fake towers', 'Private calls', 'Emergency tools', 'Nothing hides'];
const xPath = 'M33.5 33.5H42.69L50 40.81L57.31 33.5H66.5V42.69L59.19 50L66.5 57.31V66.5H57.31L50 59.19L42.69 66.5H33.5V57.31L40.81 50L33.5 42.69Z';
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {
      [0, 1].map(() => (
        <div class="ticker-group">
          {items.map((t) => (
            <span class="ticker-item">
              {t}
              <svg viewBox="33.5 33.5 33 33">
                <path d={xPath} fill="currentColor" />
              </svg>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
