---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, type PageMeta } from '../config/site';
import { organization } from '../lib/schema';

interface Props {
  meta: PageMeta;
  /** Extra JSON-LD blocks for this page. Organization is always included. */
  jsonLd?: Record<string, unknown>[];
  /** Set false for pages that must not be indexed (404). */
  index?: boolean;
}

const { meta, jsonLd = [], index = true } = Astro.props;
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = `${SITE_URL}${pathname || '/'}`;
const ogImage = `${SITE_URL}${meta.ogImage}`;
---

<!doctype html>
<html lang="en" data-theme="acid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}

    <script is:inline src="/theme-init.js"></script>
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#0A0B08" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Clairix" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <JsonLd data={[organization, ...jsonLd]} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
