---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PlayButton from '../components/PlayButton.astro';
import type { IconName } from '../lib/icons';
import { pages, PACKAGE_NAME, SECURITY_EMAIL, PLAY_LIVE, GITHUB_ISSUES_URL, GITHUB_URL } from '../config/site';
import { release, fullReleaseReady, releaseNotesUrl, sumsUrl, sigUrl, releaseSigned } from '../config/release';

// The public half of the key that signs each release's checksum list (tools/signing in the repository).
const PUBLIC_KEY_URL = `${GITHUB_URL}/blob/main/android/asset-signing.pem`;
import { softwareApplication } from '../lib/schema';

// The file name the browser saves, taken from the published URL so the hash commands match the download.
const apkUrl: string = release.apkUrl;
const apkName = apkUrl ? decodeURIComponent(apkUrl.split('/').pop() ?? '') : 'clairix-<version>.apk';

const compare: { row: string; play: string; full: string }[] = [
  { row: 'Everything on the <a class="text-link" href="/features">features page</a>', play: 'Yes', full: 'Yes' },
  {
    row: 'Card Vault with NFC card emulation',
    play: 'No',
    full: 'Yes. Record the exchange with one of your own contactless cards and have the phone present it. Cards are encrypted with a key held in the phone’s secure hardware and never leave the device.',
  },
  {
    row: 'ClairixCoin',
    play: 'No',
    full: 'Yes. A non-monetary token that members of the same relay can pass to one another. Balances and transfers are recorded by the relay; the note attached to a transfer is end-to-end encrypted. It cannot be bought or cashed out.',
  },
  { row: 'Distribution and updates', play: 'Google Play, automatic', full: 'This page, manual' },
  { row: 'Price', play: 'Free', full: 'Free' },
];

const requirements: { icon: IconName; title: string; body: string }[] = [
  { icon: 'device', title: 'Android 12 or newer.', body: 'Clairix uses platform APIs that first appeared in Android 12 (API level 31). Some checks need newer versions and say so in the app, for example screen-recording detection on Android 15.' },
  { icon: 'bluetooth', title: 'Bluetooth Low Energy', body: 'for tracker detection and the offline mesh.' },
  { icon: 'lens', title: 'A rear camera with a torch', body: 'for the lens-glint sweep, and a front camera for the infrared sweep.' },
  { icon: 'compass', title: 'Location', body: 'to confirm that a tracker is moving with you and to read Wi-Fi network names, as Android requires.' },
  { icon: 'chip', title: 'Google Play services.', body: 'The tracker scanner uses Google’s fused location provider, so a phone without Google Play services may not be able to confirm that a tracker is following you. The rest of the app does not depend on it.' },
  { icon: 'nfc', title: 'An NFC reader', body: 'for NFC features.' },
];
---

<BaseLayout meta={pages.download} jsonLd={[softwareApplication]}>
  <section class="page-hero">
    <div class="wrap">
      <p class="label">Download</p>
      <h1 class="display h1 slit"><span>Get Clairix<em>.</em></span><span>Free<em>.</em></span></h1>
      {
        PLAY_LIVE ? (
          <p class="lede">Get Clairix free on Google Play, or download Clairix Full as an APK and verify it with <span class="no-wrap">SHA-256</span>. Requires Android 12 or newer.</p>
        ) : (
          <p class="lede">Clairix is in public beta. Download it as an APK and verify it with <span class="no-wrap">SHA-256</span>. The Google Play edition is coming soon. Requires Android 12 or newer.</p>
        )
      }
    </div>
  </section>

  <section class="section editions" aria-label="Editions">
    <div class="wrap editions-grid">
      <article class:list={['edition', 'panel', 'cham', { 'edition--featured': PLAY_LIVE }]} aria-labelledby="play-title">
        <div class="edition-head">
          <span class:list={['tag', 'cham', 'cham--oct', { 'tag--line': !PLAY_LIVE }]}>{PLAY_LIVE ? 'Recommended' : 'Coming soon'}</span>
          <h2 id="play-title" class="display edition-title">Google Play</h2>
        </div>
        {
          PLAY_LIVE ? (
            <>
              <p class="muted">
                The Play edition is the version most people should install. It updates automatically, it is reviewed by Google,
                and it is the edition this site describes. Every feature is free.
              </p>
              <PlayButton size="lg" label="Download free on Google Play" />
            </>
          ) : (
            <>
              <p class="muted">
                The Play edition is on its way. Once it is out it will update automatically and will be the version most people
                should install. Every feature will be free.
              </p>
              <span class="btn btn--lg cham cham--oct" aria-disabled="true">
                Coming soon to Google Play
              </span>
            </>
          )
        }
        <p class="pkg">Package name: <code>{PACKAGE_NAME}</code></p>
      </article>

      <article class:list={['edition', 'panel', 'cham', { 'edition--featured edition--lead': !PLAY_LIVE }]} aria-labelledby="full-title-card">
        <div class="edition-head">
          <span class:list={['tag', 'cham', 'cham--oct', { 'tag--line': PLAY_LIVE }]}>{PLAY_LIVE ? 'Direct APK' : 'Beta, available now'}</span>
          <h2 id="full-title-card" class="display edition-title">Clairix Full</h2>
        </div>
        <p class="muted">
          The same app with two additional features that are not in the Play edition. It is distributed directly from this
          page as an APK that you install yourself.
        </p>
        {
          fullReleaseReady ? (
            <a class:list={['btn', 'btn--lg', 'cham', 'cham--oct', { 'btn--ghost': PLAY_LIVE }]} href={release.apkUrl} download>
              Download the APK
              <Icon name="arrowDown" size={18} />
            </a>
          ) : (
            <span class="btn btn--lg cham cham--oct" aria-disabled="true">
              Coming with the first beta
            </span>
          )
        }
        <a class="text-link pkg" href="#clairix-full">What is different, and how to verify it</a>
      </article>
    </div>
  </section>

  <section class="section" id="clairix-full" aria-labelledby="full-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack-md">
          <p class="label">Clairix Full</p>
          <h2 id="full-title" class="display h2">The same app, plus two<em>.</em></h2>
        </div>
        <p class="lede">
          Both editions use the same package name and are signed with the same key, so one installs over the other and keeps
          your data.
        </p>
      </div>

      <h3 class="h3 sub">What is different</h3>
      <div class="compare" role="table" aria-label="Play edition compared with Clairix Full">
        <div class="compare-row compare-head" role="row">
          <span role="columnheader"><span class="visually-hidden">Feature</span></span>
          <span role="columnheader">Play edition</span>
          <span role="columnheader">Clairix Full</span>
        </div>
        {
          compare.map((c) => (
            <div class="compare-row" role="row">
              <span role="rowheader" class="compare-feature" set:html={c.row} />
              <span role="cell" class:list={['compare-cell', { 'is-no': c.play === 'No' }]}>
                <span class="compare-mobile-label" aria-hidden="true">Play edition</span>
                {c.play}
              </span>
              <span role="cell" class="compare-cell">
                <span class="compare-mobile-label" aria-hidden="true">Clairix Full</span>
                {c.full}
              </span>
            </div>
          ))
        }
      </div>

      <div class="notice limits cham">
        <p class="label">Read this first</p>
        <p>
          Card emulation and the coin are left out of the Play edition because they do not fit Google Play’s policies for
          store apps. They are offered here for people who understand what they do. Emulating a card you do not own, or using
          a card in a way its issuer forbids, may break the issuer’s terms or the law where you live. You are responsible for
          how you use it.
        </p>
      </div>

      <div class="full-grid">
        <div class="release panel cham">
          <h3 class="h3">Download</h3>
          {
            fullReleaseReady ? (
              <>
                <p class="muted">
                  <strong class="text">Clairix Full {release.version}</strong> for Android 12 or newer, arm64-v8a, armeabi-v7a and
                  x86_64.
                </p>
                <a class="btn btn--lg cham cham--oct" href={release.apkUrl} download>
                  Download the APK
                  <Icon name="arrowDown" size={18} />
                </a>
                <div class="hash-block">
                  <span class="label label--plain">SHA-256</span>
                  <code class="hash">{release.sha256.toLowerCase()}</code>
                </div>
                {releaseNotesUrl && (
                  <a class="text-link" href={releaseNotesUrl} rel="noopener">
                    Release notes
                  </a>
                )}
              </>
            ) : (
              <>
                <p class="soon display">Coming with the first beta<em>.</em></p>
                <p class="muted">
                  The APK, its version number and its SHA-256 checksum will be published here together.
                </p>
              </>
            )
          }
        </div>

        <div class="verify">
          <h3 class="h3">Verify the download</h3>
          <p class="muted">
            Checking the hash confirms the file you have is the file we published and was not altered on the way. On a
            computer:
          </p>
          <pre class="code"><code><span class="c"># Linux</span>
sha256sum {apkName}

<span class="c"># macOS</span>
shasum -a 256 {apkName}

<span class="c"># Windows PowerShell</span>
Get-FileHash {apkName} -Algorithm SHA256</code></pre>
          <p class="muted">
            Compare the result with the SHA-256 above, character for character. If it differs, delete the file and download it
            again. If it differs again, write to <a class="text-link" href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a>.
          </p>
          {
            sumsUrl && (
              <>
                <p class="muted">
                  The release also carries <a class="text-link" href={sumsUrl} rel="noopener">SHA256SUMS.txt</a>, the checksums of
                  every file in it. With it in the same folder as the download:
                </p>
                <pre class="code"><code>sha256sum -c --ignore-missing SHA256SUMS.txt</code></pre>
              </>
            )
          }
          {
            releaseSigned ? (
              <>
                <p class="muted">
                  A hash published next to a file can be replaced along with it, so the checksum list is signed with the project's
                  release key: <a class="text-link" href={sigUrl} rel="noopener">SHA256SUMS.txt.sig</a> is the signature, and the
                  public half of the key is <a class="text-link" href={PUBLIC_KEY_URL} rel="noopener">android/asset-signing.pem</a>{' '}
                  in the repository. The signature is base64 without its trailing padding, which the first line puts back:
                </p>
                <pre class="code"><code>sed 's/$/==/' SHA256SUMS.txt.sig | base64 -d &gt; sums.sig
openssl pkeyutl -verify -pubin -inkey asset-signing.pem -rawin -in SHA256SUMS.txt -sigfile sums.sig</code></pre>
              </>
            ) : (
              <p class="muted">
                A hash published next to a file can be replaced along with it. This release's checksum list is not signed; releases
                after it carry a signature over the list from the project's release key, and this section will then say how to
                check it.
              </p>
            )
          }
        </div>
      </div>

      <div class="steps-grid">
        <div>
          <h3 class="h3">Install</h3>
          <ol class="numbered">
            <li>Open the downloaded APK on your phone.</li>
            <li>
              Android will ask you to allow installs from your browser or file manager. Allow it for this install only, then
              turn it back off afterwards if you prefer.
            </li>
            <li>
              Confirm the install. If you already have the Play edition, Clairix Full installs over it and keeps your data, your
              Clairix number and your message history.
            </li>
          </ol>
          <p class="muted small">
            Clairix’s own spyware check flags apps installed from outside a store. Clairix Full will appear in that list for
            exactly that reason. That is the check working as intended.
          </p>
        </div>
        <div>
          <h3 class="h3">How updates work</h3>
          <p class="muted">
            Clairix Full does not update itself and Google Play will not update it. To update, come back to this page, download
            the new APK, verify its hash and install it over the existing one. Your data stays in place. New releases are
            announced here with their release notes.
          </p>
        </div>
      </div>

      {
        !PLAY_LIVE && (
          <div class="notice limits feedback cham">
            <p class="label">Tell us what breaks</p>
            <p>
              This is a beta, and your reports decide what gets fixed first. If something does not work, looks wrong or
              confuses you, <a class="text-link" href={GITHUB_ISSUES_URL} rel="noopener">open an issue on GitHub</a> with your
              phone model, your Android version and what you did just before it happened. Security problems go to{' '}
              <a class="text-link" href={`mailto:${SECURITY_EMAIL}`}>{SECURITY_EMAIL}</a> instead, so they are not public
              before they are fixed.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section requirements" aria-labelledby="req-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Requirements</p>
        <h2 id="req-title" class="display h2">What your phone needs</h2>
      </div>
      <ul class="req-grid">
        {
          requirements.map((r) => (
            <li class="req">
              <Icon name={r.icon} size={24} class="req-icon" />
              <p>
                <strong>{r.title}</strong> {r.body}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="muted req-note">
        Clairix asks for each permission only when you open the feature that needs it. You can use most of the app without
        granting all of them.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .editions {
    padding-top: clamp(48px, 6vw, 80px);
  }
  .editions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .edition {
    --c: 24px;
    display: grid;
    gap: 22px;
    align-content: start;
    justify-items: start;
    padding: clamp(28px, 4vw, 48px);
  }
  .edition--lead {
    order: -1;
  }
  .edition--featured {
    --cham-border: var(--clx-accent);
  }
  .edition--featured::after {
    background-image: radial-gradient(90% 80% at 100% 0%, color-mix(in oklab, var(--clx-accent) 12%, transparent), transparent 60%);
  }
  .edition-head {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .edition-title {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .pkg {
    font-size: 0.9375rem;
    color: var(--clx-text-subtle);
  }
  .pkg code {
    color: var(--clx-text);
  }
  @media (max-width: 860px) {
    .editions-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sub {
    margin-bottom: 18px;
  }
  .compare {
    border-top: 1px solid var(--clx-border-strong);
  }
  .compare-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--clx-border);
    color: var(--clx-text-muted);
    font-size: 0.9375rem;
  }
  .compare-head {
    font-family: var(--clx-font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clx-text-subtle);
    padding: 14px 0;
  }
  .compare-feature {
    color: var(--clx-text);
    font-weight: 600;
  }
  .compare-cell.is-no {
    color: var(--clx-text-subtle);
  }
  .compare-mobile-label {
    display: none;
  }
  @media (max-width: 720px) {
    .compare-head {
      display: none;
    }
    .compare-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .compare-mobile-label {
      display: block;
      font-family: var(--clx-font-display);
      font-stretch: 125%;
      font-weight: 800;
      font-size: 0.625rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--clx-text-subtle);
      margin-top: 6px;
    }
  }

  .feedback {
    margin-top: clamp(48px, 6vw, 72px);
  }
  .feedback .label::before {
    background: var(--clx-accent);
  }
  .notice {
    margin-top: 32px;
    display: grid;
    gap: 10px;
    max-width: 880px;
  }

  .full-grid {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 24px;
    align-items: start;
  }
  .release {
    --c: 20px;
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .release .text {
    color: var(--clx-text);
  }
  .soon {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1;
  }
  .hash-block {
    display: grid;
    gap: 6px;
    width: 100%;
    padding: 14px 16px;
    background: var(--clx-base);
    border: 1px solid var(--clx-border);
  }
  .verify {
    display: grid;
    gap: 16px;
    padding-top: 8px;
  }
  .code {
    margin: 0;
    padding: 18px 20px;
    background: var(--clx-surface);
    border: 1px solid var(--clx-border);
    border-left: 3px solid var(--clx-accent);
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: var(--clx-font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--clx-text);
  }
  .code .c {
    color: var(--clx-text-subtle);
  }
  @media (max-width: 860px) {
    .full-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .steps-grid {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 64px);
  }
  .steps-grid .h3 {
    margin-bottom: 16px;
  }
  .numbered {
    list-style: none;
    padding: 0;
    counter-reset: n;
    display: grid;
    gap: 12px;
    color: var(--clx-text-muted);
    margin-bottom: 16px;
  }
  .numbered li {
    counter-increment: n;
    position: relative;
    padding-left: 2.4em;
  }
  .numbered li::before {
    content: counter(n, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15em;
    font-family: var(--clx-font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: 0.8125rem;
    color: var(--clx-accent);
  }
  .small {
    font-size: 0.9375rem;
  }
  @media (max-width: 860px) {
    .steps-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .requirements {
    background: var(--clx-surface);
  }
  .req-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--clx-border);
    border: 1px solid var(--clx-border);
  }
  .req {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 28px 24px;
    background: var(--clx-surface);
    color: var(--clx-text-muted);
  }
  .req strong {
    color: var(--clx-text);
  }
  .req :global(.req-icon) {
    color: var(--clx-accent);
  }
  .req-note {
    margin-top: 24px;
  }
  @media (max-width: 960px) {
    .req-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .req-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
