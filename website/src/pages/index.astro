---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroScanner from '../components/HeroScanner.astro';
import FeatureVisual from '../components/FeatureVisual.astro';
import Ticker from '../components/Ticker.astro';
import PlayButton from '../components/PlayButton.astro';
import type { IconName } from '../lib/icons';
import { pages, PLAY_LIVE } from '../config/site';
import { softwareApplication, faqPage, toPlainText } from '../lib/schema';

const comms: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'comms',
    title: 'No phone number.',
    body: 'You get a Clairix number: nine random digits that are not your phone number and say nothing about who you are. Pair in person by scanning a code, or send an invite link that only Clairix can open.',
  },
  {
    icon: 'key',
    title: 'Sealed end to end.',
    body: 'Every message, voice note, photo and call is encrypted on your phone with the Olm double ratchet, then sealed so the relay sees who it is for, never who sent it or what it says.',
  },
  {
    icon: 'server',
    title: 'Relays anyone can run.',
    body: 'Use ours, a friend’s, or your own, set up with one script. If your relay is blocked or no longer one you trust, move to another and keep your contacts: their phones follow you.',
  },
  {
    icon: 'shield',
    title: 'Made for a hostile network.',
    body: 'Tor is built in, and relays with onion addresses are reached without leaving it. Sends spend blind tokens, the relay shuffles what passes through, and a stranger cannot flood your mailbox.',
  },
  {
    icon: 'lock',
    title: 'A locked phone gives nothing away.',
    body: 'While your phone is locked, messages are collected but stay sealed until you unlock. A call rings as “Clairix call”, naming no one, and notifications show no names or text.',
  },
  {
    icon: 'bluetooth',
    title: 'When the network is down.',
    body: 'With the offline mesh on, texts and SOS travel phone to phone over Bluetooth until one reaches the person they are for.',
  },
];

interface DetectCard {
  id: string;
  icon: IconName;
  title: string;
  body: string;
  limit: string;
}

const detection: DetectCard[] = [
  {
    id: 'hidden-cameras',
    icon: 'lens',
    title: 'Hidden cameras',
    body: 'Sweep a room with the torch: a lens reflects light straight back and holds still while other glints slide. Infrared mode, Wi-Fi and Bluetooth checks and a magnet gauge go further.',
    limit: 'It cannot see a camera with no line of sight to you, or one that only records to a memory card.',
  },
  {
    id: 'trackers',
    icon: 'tracker',
    title: 'Trackers following you',
    body: 'AirTags, Tile, SmartTag, Chipolo, Pebblebee, Google Find Hub and unbranded GPS boxes, followed through their address rotations. A recognised tracker moving with you is flagged as following; anything else that rides along says "travelling with you" so you can judge it yourself.',
    limit: 'It cannot hear a tracker that never broadcasts over Bluetooth.',
  },
  {
    id: 'spyware',
    icon: 'spyware',
    title: 'Spyware on your phone',
    body: 'Every app checked for the signs stalkerware shows, weighed together so one permission never accuses an app. Plus installed certificates, proxies, debugging, and a record of who unlocked the phone.',
    limit: 'It cannot see what root-level or system-level spyware hides, and says when a phone can no longer be trusted.',
  },
  {
    id: 'networks',
    icon: 'tower',
    title: 'Fake networks, towers and GPS',
    body: 'A test that catches hotspots answering to any name, a learned baseline for the cell towers around you, and checks for GPS spoofing, 2G and VPN leaks.',
    limit: 'No phone can prove a tower is fake: you get indicators and a score, never a verdict.',
  },
];

const emergency: { icon: IconName; title: string; body: string }[] = [
  { icon: 'sos', title: 'SOS', body: 'Hold the button until it fills and confirm, and your location goes, end-to-end encrypted, to the people in your groups. Location is read at that moment and at no other time.' },
  { icon: 'phrase', title: 'Duress phrase', body: 'An ordinary-looking sentence you can type into any chat. The message goes out as written. Underneath, the SOS fires. Anyone watching the screen sees a normal conversation.' },
  { icon: 'phone', title: 'Fake call', body: 'Schedule an incoming call for 30 seconds, 2 minutes or 5 minutes from now. Your phone rings with its real ringtone and shows a real-looking call screen. Answer it and walk away, or have it place a real encrypted call to a contact.' },
  { icon: 'lock', title: 'App lock', body: 'A passcode protects Clairix itself, with optional biometric unlock. Too many wrong attempts can wipe the app’s data. A separate duress passcode wipes it immediately and shows nothing unusual.' },
  { icon: 'wipe', title: 'Panic wipe', body: 'One action deletes everything Clairix holds on your phone, asks the relay to delete your account, and destroys the keys so nothing left behind can be read.' },
];

const trust: { icon: IconName; title: string; body: string }[] = [
  { icon: 'ban', title: 'No ads. No analytics. No trackers.', body: 'There is no advertising SDK, analytics SDK or crash reporter in the app. We cannot see how you use it.' },
  { icon: 'device', title: 'What it finds stays on your phone.', body: 'Bluetooth, Wi-Fi, cellular and NFC scan results, your timeline, your location history, your app list and your unlock ledger are never uploaded. Android backups are turned off for Clairix.' },
  { icon: 'eye', title: 'The exceptions are named.', body: 'Messages pass through your relay as sealed envelopes, and on to your contact’s relay when it is another one, or phone to phone over Bluetooth with the offline mesh on. Map tiles come from OpenStreetMap. SOS alerts carry your location, end-to-end encrypted, to the people in your groups. Every destination, and what it can see, is listed on the <a class="text-link" href="/security">security page</a>.' },
  { icon: 'key', title: 'Standard cryptography.', body: 'vodozemac, the audited implementation of the Olm double ratchet. X25519, HKDF-SHA256 and ChaCha20-Poly1305 for sealed envelopes, blind tokens to RFC 9497, Ed25519 signatures instead of passwords, and keys in Android’s hardware-backed keystore.' },
  { icon: 'doc', title: 'Open source, and checked against its source.', body: 'Clairix is free software under the GNU GPL version 3. Every release is rebuilt from its source on a separate machine and must match what was published. The <a class="text-link" href="https://github.com/jakes1345/Clairix/tree/main/docs/audit">audit pack</a> sets out the threat model for independent reviewers.' },
  { icon: 'gauge', title: 'Open about limits.', body: 'Every feature says what it cannot do. Detection is a strong aid, not a guarantee, and Clairix has not yet had an independent audit.' },
];

const faqs: { q: string; a: string }[] = [
  { q: 'Does Clairix see my messages?', a: 'No. Messages are encrypted on your phone for one recipient before they leave it. The relay stores sealed envelopes it cannot open, and it does not learn who sent them. We could not read your messages if we wanted to.' },
  { q: 'What does the relay store about me?', a: 'Your Clairix number, your public keys, any encrypted envelopes waiting for your phone (deleted on delivery or after 30 days), the key your contacts’ passes are checked with, a push endpoint if you set one up, and short-lived counters that keep abuse in check. There is no name, phone number or email on the relay. <a href="/security#relay">Full details.</a>' },
  { q: 'Can I run my own relay?', a: 'Yes. One script sets up a relay on a server of your own, behind HTTPS and an onion address. Relays reach each other, so you can still talk to people on other relays, and you can move your number to another relay at any time without losing your contacts.' },
  { q: 'Is Clairix open source?', a: 'Yes. The app, the relay and the encryption library are free software under the GNU GPL version 3, and the source is on <a href="https://github.com/jakes1345/Clairix">GitHub</a>. Every release is rebuilt from its source and compared with what was published.' },
  { q: 'Can Clairix find every hidden camera?', a: 'No. The optical sweep finds a camera when its lens has line of sight to you and you can point the phone at it. It cannot see a camera behind a solid surface, a camera pointing away from you, or one hidden where you did not look. The network checks find cameras that stream over the venue’s Wi-Fi or are still in setup mode. Cameras that only record to a memory card, and analogue wireless cameras, transmit nothing a phone’s radios can hear.' },
  { q: 'Will it alert me every time an AirTag is nearby?', a: 'No. A tracker in the next apartment or a stranger’s bag on the train is not a threat and would train you to ignore alerts. Clairix only confirms a tracker as following you after it has been heard with you across real distance over real time. Devices that are merely around are listed quietly, without an alarm.' },
  { q: 'Does Clairix track my location?', a: 'The tracker scanner uses your location to tell whether a device is moving with you, and your location history is stored on your phone only. Location is sent off the phone in exactly one case: when you press SOS or type your duress phrase, your position is sent end-to-end encrypted to your chosen contacts.' },
  { q: 'Why does it need so many permissions?', a: 'Because the threats live in different radios. Bluetooth for trackers and the offline mesh, location to confirm movement and check GPS, camera for the lens sweep, Wi-Fi for fake hotspots, phone state for cell towers, microphone for calls and the ultrasound check. Each permission is asked for only when you open the feature that needs it, and you can skip scanning entirely and use Clairix just to talk.' },
  { q: 'Is Clairix free?', a: 'Yes, every feature is free.' },
  { q: 'Does Clairix work on iPhone?', a: 'No. Clairix is built for Android 12 and newer. Much of what it does, such as scanning for unknown Bluetooth devices with the screen off or inspecting installed apps, is not possible for third-party apps on iOS.' },
  { q: 'Is Clairix a replacement for calling for help?', a: 'No. If you believe you are in danger, contact local emergency services. Clairix is a private channel to the people you trust and a detection aid.' },
];

const jsonLd = [softwareApplication, faqPage(faqs.map((f) => ({ q: f.q, a: toPlainText(f.a) })))];
---

<BaseLayout meta={pages.home} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="label">Private messaging and personal security for Android</p>
        <h1 id="hero-title" class="display h1 hero-title slit">
          <span>Nothing</span>
          <span>hides<em>.</em></span>
        </h1>
        <p class="lede hero-lede">
          Messages and calls that only the two of you can read, through relays anyone can run, that keep working when one
          is blocked. And the tools to find hidden cameras, trackers and spyware. Everything Clairix learns stays on your
          phone.
        </p>
        <div class="btn-row">
          <PlayButton size="lg" />
          {PLAY_LIVE && (
            <a class="btn btn--lg btn--ghost cham cham--oct" href="/download#clairix-full">
              Download Clairix Full
              <Icon name="arrowDown" size={18} />
            </a>
          )}
        </div>
        <p class="hero-fine">Free and open source. No ads, no phone number, no account to start. Android 12 or newer.</p>
      </div>
      <div class="hero-art">
        <HeroScanner />
      </div>
    </div>
  </section>

  <Ticker />

  <!-- Messaging -->
  <section class="section" id="comms" aria-labelledby="comms-title">
    <div class="wrap">
      <div class="comms-grid">
        <div class="comms-copy">
          <p class="label"><span class="num">01</span> Private comms</p>
          <h2 id="comms-title" class="display h2">Talk without being watched<em>.</em></h2>
          <p class="feature-lede">
            Messages, voice notes, photos and calls that only the two of you can read or hear, through a relay that cannot
            tell who sent them.
          </p>
          <div class="link-row">
            <a class="text-link feature-link" href="/features#comms">
              How messaging works, and its limits
              <Icon name="arrowRight" size={16} />
            </a>
            <a class="text-link feature-link" href="/security#relay">
              What the relay can see
              <Icon name="arrowRight" size={16} />
            </a>
          </div>
        </div>
        <div class="comms-art" data-reveal>
          <FeatureVisual variant="cipher" label="Sealed envelope" caption="The relay cannot open it" />
        </div>
      </div>
      <ul class="points">
        {
          comms.map((c) => (
            <li class="point" data-reveal>
              <span class="icon-tile cham cham--oct">
                <Icon name={c.icon} size={22} />
              </span>
              <div>
                <h3 class="h3">{c.title}</h3>
                <p class="muted">{c.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Detection -->
  <section class="section" id="detection" aria-labelledby="detection-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack-md">
          <p class="label"><span class="num">02</span> Detection</p>
          <h2 id="detection-title" class="display h2">Find what’s watching you<em>.</em></h2>
        </div>
        <p class="lede">
          Checks that use the radios and sensors your phone already has, run only when you start them, and say plainly what
          they cannot find.
        </p>
      </div>
      <div class="detect">
        {
          detection.map((d) => (
            <a class="detect-card panel cham" href={`/features#${d.id}`} data-reveal>
              <span class="icon-tile cham cham--oct">
                <Icon name={d.icon} size={24} />
              </span>
              <h3 class="h3">{d.title}</h3>
              <p class="muted">{d.body}</p>
              <p class="detect-limit">
                <span class="label">Cannot</span>
                {d.limit}
              </p>
              <span class="detect-cta">
                How it works <Icon name="arrowRight" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Emergency -->
  <section class="section" id="emergency" aria-labelledby="emergency-title">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div class="stack-md">
          <p class="label"><span class="num">03</span> Emergency</p>
          <h2 id="emergency-title" class="display h2">Be ready for an emergency</h2>
        </div>
        <p class="lede"><strong>A few quiet tools for when a situation turns.</strong></p>
      </div>
      <div class="tools">
        {
          emergency.map((t) => (
            <article class="tool panel cham" data-reveal>
              <span class="icon-tile cham cham--oct">
                <Icon name={t.icon} size={24} />
              </span>
              <h3 class="h3">{t.title}</h3>
              <p class="muted">{t.body}</p>
            </article>
          ))
        }
        <a class="tool tool--link panel cham" href="/features#emergency" data-reveal>
          <span class="display tool-link-title">Every emergency tool, and what it cannot do</span>
          <span class="tool-link-cta">
            Read more <Icon name="arrowRight" size={18} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section trust" aria-labelledby="trust-title">
    <div class="wrap trust-grid">
      <div class="trust-head">
        <p class="label">Trust</p>
        <h2 id="trust-title" class="display h2">Built to be trusted</h2>
        <p class="lede">A security app should be the easiest app on your phone to audit.</p>
        <a class="btn btn--ghost cham cham--oct" href="/security#egress">
          What leaves your phone
          <Icon name="arrowRight" size={18} class="icon--move" />
        </a>
      </div>
      <ul class="trust-list">
        {
          trust.map((t) => (
            <li class="trust-item" data-reveal>
              <Icon name={t.icon} size={28} class="trust-icon" />
              <div>
                <h3 class="h3">{t.title}</h3>
                <p class="muted" set:html={t.body} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <p class="label">FAQ</p>
        <h2 id="faq-title" class="display h2">Questions people ask</h2>
        <p class="muted">
          Something else? Write to <a class="text-link" href="mailto:support@clairix.app">support@clairix.app</a>. We answer
          our own email.
        </p>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <span class="faq-icon cham cham--oct" aria-hidden="true">
                  <Icon name="plus" size={16} />
                </span>
              </summary>
              <div class="faq-body">
                <p set:html={f.a} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="final" aria-labelledby="final-title">
    <div class="wrap">
      <div class="final-panel cham">
        <div class="final-copy">
          <h2 id="final-title" class="display final-title slit">
            <span>Know what’s</span>
            <span>watching<em>.</em></span>
          </h2>
          <p class="lede">Every feature, free. No ads, no analytics, nothing to sign up for.</p>
          <div class="btn-row">
            <PlayButton size="lg" />
          </div>
          {PLAY_LIVE && (
            <p class="muted final-alt">
              Prefer to install it yourself? <a class="text-link" href="/download#clairix-full">Download Clairix Full.</a>
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(56px, 8vw, 112px) clamp(64px, 8vw, 120px);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(60% 70% at 78% 40%, color-mix(in oklab, var(--clx-accent) 9%, transparent), transparent 65%),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 100% 100%, 56px 56px, 56px 56px;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .hero-title {
    font-size: clamp(3.25rem, 7.6vw, 7rem);
    line-height: 0.88;
    margin-top: 4px;
    --slit-at: 50%;
    --slit-w: 0.03em;
  }
  .hero-lede {
    font-size: clamp(1.125rem, 1.7vw, 1.375rem);
    color: var(--clx-text-muted);
    max-width: 34em;
  }
  .hero-fine {
    font-size: 0.875rem;
    color: var(--clx-text-subtle);
  }
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-art {
      max-width: 440px;
      width: 100%;
      justify-self: center;
    }
  }
  @media (max-width: 480px) {
    .hero .btn-row {
      width: 100%;
    }
    .hero .btn-row > :global(*) {
      width: 100%;
    }
  }

  /* Messaging */
  .comms-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .comms-copy {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .comms-copy .h2 {
    font-size: clamp(1.75rem, 4.4vw, 3.5rem);
  }
  .feature-lede {
    font-family: var(--clx-font-ui);
    font-weight: 700;
    font-size: clamp(1.1875rem, 1.8vw, 1.4375rem);
    line-height: 1.35;
    color: var(--clx-text);
    max-width: 30em;
  }
  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .points {
    list-style: none;
    padding: 0;
    margin-top: clamp(40px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 48px);
    border-top: 1px solid var(--clx-border-strong);
    padding-top: clamp(28px, 4vw, 48px);
  }
  .point {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .point .h3 {
    margin-bottom: 8px;
  }
  @media (max-width: 960px) {
    .comms-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .comms-art {
      order: -1;
      max-width: 440px;
      width: 100%;
    }
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Detection */
  .detect {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .detect-card {
    display: grid;
    gap: 16px;
    align-content: start;
    color: var(--clx-text);
    text-decoration: none;
  }
  .detect-card:hover {
    --cham-border: var(--clx-accent);
  }
  .detect-limit {
    display: grid;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--clx-text-subtle);
    border-top: 1px solid var(--clx-border);
    padding-top: 14px;
  }
  .detect-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--clx-accent);
  }
  @media (max-width: 860px) {
    .detect {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Emergency */
  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .tool {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .tool--link {
    --cham-fill: var(--clx-accent);
    --cham-border: var(--clx-accent);
    color: var(--clx-on-accent);
    text-decoration: none;
    align-content: space-between;
    min-height: 220px;
  }
  .tool--link:hover {
    --cham-fill: var(--clx-accent-hover);
  }
  .tool-link-title {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.05;
  }
  .tool-link-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }
  @media (max-width: 960px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Trust */
  .trust {
    background: var(--clx-surface);
  }
  .trust-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .trust-head {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .trust-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--clx-border-strong);
  }
  .trust-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--clx-border);
  }
  .trust-item .h3 {
    margin-bottom: 8px;
  }
  .trust-item :global(.trust-icon) {
    color: var(--clx-accent);
    margin-top: 2px;
  }
  @media (max-width: 960px) {
    .trust-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .trust-head {
      position: static;
    }
  }

  /* FAQ */
  .faq-grid {
    display: grid;
