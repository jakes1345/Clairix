---
import DocLayout from '../layouts/DocLayout.astro';
import { Content, getHeadings } from '../content/docs/privacy.md';
import { pages } from '../config/site';
---

<DocLayout meta={pages.privacy} label="Legal" title="Privacy Policy" headings={getHeadings()} tags={['Effective 25 October 2026']}>
  <p class="lede" slot="lede">What stays on your phone, what leaves it and where it goes, what the relay keeps and for how long, and how to delete your data.</p>
  <article class="prose"><Content /></article>
</DocLayout>
