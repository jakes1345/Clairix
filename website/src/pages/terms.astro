---
import DocLayout from '../layouts/DocLayout.astro';
import { Content, getHeadings } from '../content/docs/terms.md';
import { pages } from '../config/site';
---

<DocLayout meta={pages.terms} label="Legal" title="Terms of Service" headings={getHeadings()} tags={['Effective 18 October 2026']}>
  <p class="lede" slot="lede">The terms for using the Clairix app and relay, including acceptable use and the limits of detection.</p>
  <article class="prose"><Content /></article>
</DocLayout>
